# Server
PORT=5100
NODE_ENV=development   # set to "production" on Render

# MongoDB Atlas connection string
# Create a free cluster at https://cloud.mongodb.com
MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=1d

# Socket.io CORS — set to your Render frontend URL in production
# Example: https://payroll-app.onrender.com
# Leave unset to default to same-origin (safe for full-stack Render deploys)
CLIENT_URL=
